# Downloaded toolchain binaries (~800MB) -- never commit these.
# Reproduce with: scripts/get-sui.sh  (see README)
.tools/

# Move build output
build/
**/build/

# Rust build output
target/
**/target/

# Node
node_modules/

# Local keys & env -- CRITICAL: never commit a private key
.env
*.key
sui.keystore
.aptos/

# A localnet deployment is thrown away with the node.
deployments/aptos-local.json
client.yaml

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Personal study notes -- a learning/reference resource, not part of the repo.
# Regenerate or edit freely; nothing here is imported by the build.
study/

# Python bytecode (bench/gas.py imports the scripts/ modules)
__pycache__/

# Local working memory -- session state, funding status, running notes.
# Untracked on purpose: it records what *this machine* has done, not the repo.
NOTES.local.md
.braid-local/

# Live snapshot the web server writes when it re-reads the chain. Scratch:
# the committed first-route snapshot is the one that is a record.
deployments/routes/.live-snapshot.json
