# The README claims seven Move sources are byte-identical between move/sui and
# move/aptos, and `diff` between the trees is part of how that is demonstrated.
# On a Windows checkout, autocrlf converts some files and not others, so the
# same content can look different on disk. Pin every source to LF so the claim
# is checkable wherever it is cloned.
*.move   text eol=lf
*.rs     text eol=lf
*.toml   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.mts    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.css    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.sh     text eol=lf
Dockerfile text eol=lf

# Move.lock records dependency paths. Generated on Windows it records them with
# backslashes, which are a literal filename component on every other platform --
# the Sui packages then fail to resolve their framework dependency at all. CI
# guards against the separators; this guards against the line endings.
Move.lock text eol=lf

# Generated corpora: the point is that regenerating produces no diff.
*.move linguist-generated=false
